#!/usr/bin/env bash

set -euo pipefail

staging_root=""

locale_is_zh() {
    local locale
    for locale in "${LANGUAGE:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
        [[ -n "$locale" ]] || continue
        [[ "$locale" == zh* ]]
        return
    done
    return 1
}

usage() {
    if locale_is_zh; then cat <<'EOF'
用法：omavoicectl <命令>

管理OmaVoice Linux 用户服务。

命令：
  status      查看已安装的用户服务状态
  start       启用并启动已安装的用户服务
  stop        停止已安装的用户服务
  restart     重启已安装的用户服务
  logs        持续查看已安装的用户服务日志
  doctor      检查当前 Omarchy 环境和阶段就绪状态
  uninstall   停止服务并仅移除 OmaVoice 安装的用户态文件
  help        显示帮助
EOF
    else cat <<'EOF'
Usage: omavoicectl <command>

Manage OmaVoice Linux user services.

Commands:
  status      Show installed user-service status
  start       Enable and start installed user services
  stop        Stop installed user services
  restart     Restart installed user services
  logs        Follow installed user-service logs
  doctor      Check the current Omarchy environment and phase readiness
  uninstall   Stop services and remove only OmaVoice-installed user files
  help        Show help
EOF
    fi
}

fail() {
    if locale_is_zh; then printf '错误：%s\n' "${2:-$1}" >&2; else printf 'Error: %s\n' "$1" >&2; fi
    exit 1
}

if [[ "${1:-}" == "--staging-root" ]]; then
    (( $# >= 3 )) || fail "--staging-root requires a directory and command" "--staging-root 需要目录和命令"
    staging_root="$2"
    [[ "$staging_root" == /* ]] || fail "--staging-root must be an absolute path" "--staging-root 必须是绝对路径"
    [[ -d "$staging_root" ]] || fail "--staging-root does not exist" "--staging-root 目录不存在"
    staging_root="$(cd -- "$staging_root" && pwd -P)"
    [[ "$staging_root" != "/" ]] || fail "--staging-root cannot be the system root" "--staging-root 不得为系统根目录"
    shift 2
fi

command_name="${1:-help}"
(( $# <= 1 )) || fail "too many command arguments" "命令参数过多"
(( EUID != 0 )) || fail "run as a regular user, without sudo" "请以普通用户运行，不要使用 sudo"

home_directory="${HOME:-}"
[[ "$home_directory" == /* ]] || fail "HOME must be an absolute path" "HOME 必须是绝对路径"
config_home="${XDG_CONFIG_HOME:-$home_directory/.config}"
data_home="${XDG_DATA_HOME:-$home_directory/.local/share}"
[[ "$config_home" == /* ]] || fail "XDG_CONFIG_HOME must be an absolute path" "XDG_CONFIG_HOME 必须是绝对路径"
[[ "$data_home" == /* ]] || fail "XDG_DATA_HOME must be an absolute path" "XDG_DATA_HOME 必须是绝对路径"

readonly ATVVOICE_UNIT="omavoice-atvvoice.service"
readonly SETTINGS_UNIT="omavoice-settings.service"
readonly HANDY_UNIT="omavoice-handy.service"
readonly STATISTICS_UNIT="omavoice-statistics.service"

service_units=("$ATVVOICE_UNIT" "$SETTINGS_UNIT")
if [[ -f "$config_home/systemd/user/$STATISTICS_UNIT" ]]; then
    service_units+=("$STATISTICS_UNIT")
fi
if [[ -f "$config_home/systemd/user/$HANDY_UNIT" ]]; then
    service_units+=("$HANDY_UNIT")
fi

require_live_session() {
    [[ -z "$staging_root" ]] || fail "only uninstall supports a staging root" "隔离根目录只支持 uninstall 命令"
    command -v systemctl >/dev/null 2>&1 || fail "systemctl is required" "缺少命令：systemctl"
}

case "$command_name" in
    status)
        require_live_session
        systemctl --user --no-pager --full status "${service_units[@]}"
        ;;
    start)
        require_live_session
        systemctl --user enable --now "${service_units[@]}"
        ;;
    stop)
        require_live_session
        systemctl --user stop "${service_units[@]}"
        ;;
    restart)
        require_live_session
        systemctl --user restart "${service_units[@]}"
        ;;
    logs)
        require_live_session
        journal_arguments=()
        for unit in "${service_units[@]}"; do
            journal_arguments+=(--unit "$unit")
        done
        exec journalctl --user --follow "${journal_arguments[@]}"
        ;;
    doctor)
        [[ -z "$staging_root" ]] || fail "doctor does not support a staging root" "隔离根目录不支持 doctor 命令"
        exec "$home_directory/.local/bin/omavoice-doctor" --phase 1
        ;;
    uninstall)
        uninstaller="$staging_root$data_home/omavoice/uninstall.sh"
        [[ -x "$uninstaller" ]] || fail \
            "trusted release uninstaller not found: $uninstaller" \
            "未找到可信的 Release 卸载器：$uninstaller"
        if [[ -n "$staging_root" ]]; then
            exec "$uninstaller" --staging-root "$staging_root"
        fi
        exec "$uninstaller"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        fail "unrecognized command: $command_name" "无法识别的命令“$command_name”"
        ;;
esac
