+                        break 'discover;
+                    }
+                }
+                continue;
+            }
+
             match &session_result {
                 Ok(()) => tracing::info!("Session ended"),
                 Err(e) if is_device_locked_error(e) => {
diff --git a/src/pw.rs b/src/pw.rs
index 2aa4e7f..64b2631 100644
--- a/src/pw.rs
+++ b/src/pw.rs
@@ -32,6 +32,14 @@ const SAMPLE_SIZE: usize = std::mem::size_of::<i16>();
 #[derive(Debug)]
 pub struct Shutdown;
 
+/// Whether a PipeWire stream state means its server connection must be rebuilt.
+fn source_connection_lost(state: &pipewire::stream::StreamState) -> bool {
+    matches!(
+        state,
+        pipewire::stream::StreamState::Unconnected | pipewire::stream::StreamState::Error(_)
+    )
+}
+
 /// Drop samples captured while the PipeWire source was not streaming.
 fn clear_stale_audio(
     audio_rx: &mpsc::Receiver<Vec<i16>>,
@@ -70,11 +78,14 @@ pub fn run_pw_source(
     // Shared slot for the stream - set after creation, used by shutdown handler.
     let stream_slot: std::rc::Rc<std::cell::RefCell<Option<StreamRc>>> =
         std::rc::Rc::new(std::cell::RefCell::new(None));
+    let shutdown_requested = std::rc::Rc::new(std::cell::Cell::new(false));
     let _receiver = shutdown_rx.attach(mainloop.loop_(), {
         let mainloop = mainloop.clone();
         let stream_slot = stream_slot.clone();
+        let shutdown_requested = shutdown_requested.clone();
         move |_: Shutdown| {
             tracing::info!("PipeWire source shutting down");
+            shutdown_requested.set(true);
             // Disconnect stream while mainloop is alive (cpal pattern).
             if let Some(stream) = stream_slot.borrow().as_ref() {
                 let _ = stream.disconnect();
@@ -129,9 +140,17 @@ pub fn run_pw_source(
             let stream_for_id = stream.clone();
             let audio_rx = audio_rx.clone();
             let pending = pending.clone();
+            let mainloop = mainloop.clone();
+            let shutdown_requested = shutdown_requested.clone();
             move |_, _, old, new| {
                 tracing::debug!("PipeWire stream state: {old:?} -> {new:?}");
 
+                if !shutdown_requested.get() && source_connection_lost(&new) {
+                    tracing::warn!("PipeWire connection lost; rebuilding source");
+                    mainloop.quit();
+                    return;
+                }
+
                 if !matches!(&old, pipewire::stream::StreamState::Streaming)
                     && matches!(&new, pipewire::stream::StreamState::Streaming)
                 {
@@ -463,6 +482,19 @@ pub fn run_pw_source(
 mod tests {
     use super::*;
 
+    #[test]
+    fn terminal_pipewire_states_require_source_restart() {
+        use pipewire::stream::StreamState;
+
+        assert!(source_connection_lost(&StreamState::Unconnected));
+        assert!(source_connection_lost(&StreamState::Error(
+            "server stopped".to_string()
+        )));
+        assert!(!source_connection_lost(&StreamState::Connecting));
+        assert!(!source_connection_lost(&StreamState::Paused));
+        assert!(!source_connection_lost(&StreamState::Streaming));
+    }
+
     #[test]
     fn clear_stale_audio_discards_channel_and_pending_samples() {
         let (audio_tx, audio_rx) = mpsc::channel();
