From 93b085b70039d6fdf4fbfc79fa23d23d4d82f84f Mon Sep 17 00:00:00 2001
From: Jinhui Lin <fovwin@gmail.com>
Date: Sat, 22 Aug 2026 16:10:44 +0800
Subject: [PATCH 2/5] fix: discard stale PipeWire audio on resume

Amp-Thread-ID: https://ampcode.com/threads/T-01a027b2-41a4-7429-976c-b1fee0c90a27
Co-authored-by: Amp <amp@ampcode.com>
---
 src/main.rs | 10 +++++++--
 src/pw.rs   | 65 +++++++++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 69 insertions(+), 6 deletions(-)

diff --git a/src/main.rs b/src/main.rs
index 375066b..97ce289 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -393,7 +393,8 @@ async fn main() -> anyhow::Result<()> {
             let sample_rate = codec.sample_rate();
             let (frame_tx, mut frame_rx) =
                 tokio::sync::mpsc::channel::<protocol::types::AudioFrame>(DECODER_CHANNEL_CAPACITY);
-            let (pcm_tx, pcm_rx) = std::sync::mpsc::channel::<Vec<i16>>();
+            let (pcm_tx, pcm_rx) =
+                std::sync::mpsc::sync_channel::<Vec<i16>>(DECODER_CHANNEL_CAPACITY);
             let (pw_shutdown_tx, pw_shutdown_rx) =
                 pipewire::channel::channel::<pw::Shutdown>();
 
@@ -427,7 +428,12 @@ async fn main() -> anyhow::Result<()> {
                     let mut samples = frame.samples;
                     adpcm::declip(&mut samples);
                     adpcm::lowpass(&mut samples);
-                    let _ = pcm_tx.send(samples);
+                    match pcm_tx.try_send(samples) {
+                        Ok(()) => {}
+                        // No PipeWire consumer: keep the channel bounded and discard audio.
+                        Err(std::sync::mpsc::TrySendError::Full(_)) => {}
+                        Err(std::sync::mpsc::TrySendError::Disconnected(_)) => break,
+                    }
                 }
             });
 
diff --git a/src/pw.rs b/src/pw.rs
index 11102e6..2aa4e7f 100644
--- a/src/pw.rs
+++ b/src/pw.rs
@@ -32,6 +32,22 @@ const SAMPLE_SIZE: usize = std::mem::size_of::<i16>();
 #[derive(Debug)]
 pub struct Shutdown;
 
+/// Drop samples captured while the PipeWire source was not streaming.
+fn clear_stale_audio(
+    audio_rx: &mpsc::Receiver<Vec<i16>>,
+    pending: &std::cell::RefCell<Vec<i16>>,
+) -> usize {
+    let mut pending = pending.borrow_mut();
+    let mut dropped = pending.len();
+    pending.clear();
+
+    while let Ok(frame) = audio_rx.try_recv() {
+        dropped += frame.len();
+    }
+
+    dropped
+}
+
 /// Run the PipeWire audio source on the current thread (blocking).
 ///
 /// Reads decoded PCM frames from `audio_rx` and pushes them to PipeWire as a
@@ -87,8 +103,11 @@ pub fn run_pw_source(
     // Give the shutdown handler a reference to the stream.
     *stream_slot.borrow_mut() = Some(stream.clone());
 
+    // Shared by the state and process callbacks, which run on this mainloop thread.
+    let audio_rx = std::rc::Rc::new(audio_rx);
+
     // Buffer of pending PCM samples not yet consumed by PipeWire callbacks.
-    let pending: std::cell::RefCell<Vec<i16>> = std::cell::RefCell::new(Vec::new());
+    let pending = std::rc::Rc::new(std::cell::RefCell::new(Vec::<i16>::new()));
 
     // Precompute linear gain multiplier outside the RT callback to avoid
     // recomputing powf() on every frame.
@@ -101,15 +120,31 @@ pub fn run_pw_source(
     let our_node_id: std::rc::Rc<std::cell::Cell<u32>> =
         std::rc::Rc::new(std::cell::Cell::new(u32::MAX));
 
+    let process_audio_rx = audio_rx.clone();
+    let process_pending = pending.clone();
     let _listener = stream
         .add_local_listener_with_user_data(())
         .state_changed({
             let our_node_id = our_node_id.clone();
             let stream_for_id = stream.clone();
+            let audio_rx = audio_rx.clone();
+            let pending = pending.clone();
             move |_, _, old, new| {
                 tracing::debug!("PipeWire stream state: {old:?} -> {new:?}");
+
+                if !matches!(&old, pipewire::stream::StreamState::Streaming)
+                    && matches!(&new, pipewire::stream::StreamState::Streaming)
+                {
+                    let dropped = clear_stale_audio(&audio_rx, &pending);
+                    if dropped > 0 {
+                        tracing::debug!(
+                            "discarded {dropped} stale samples before PipeWire resumed"
+                        );
+                    }
+                }
+
                 if matches!(
-                    new,
+                    &new,
                     pipewire::stream::StreamState::Paused
                         | pipewire::stream::StreamState::Streaming
                 ) {
@@ -125,10 +160,10 @@ pub fn run_pw_source(
             // NOTE: Vec operations (extend, drain) allocate inside this RT callback.
             // At ~30 fps with 257 samples/frame, allocation pressure is negligible
             // and not a real-time concern for voice audio rates.
-            let mut buf = pending.borrow_mut();
+            let mut buf = process_pending.borrow_mut();
 
             loop {
-                match audio_rx.try_recv() {
+                match process_audio_rx.try_recv() {
                     Ok(mut frame) => {
                         crate::adpcm::apply_gain_linear(&mut frame, gain_linear);
                         buf.extend_from_slice(&frame);
@@ -423,3 +458,25 @@ pub fn run_pw_source(
     tracing::info!("PipeWire source stopped");
     Ok(())
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn clear_stale_audio_discards_channel_and_pending_samples() {
+        let (audio_tx, audio_rx) = mpsc::channel();
+        audio_tx.send(vec![1, 2, 3]).unwrap();
+        audio_tx.send(vec![4, 5]).unwrap();
+        let pending = std::cell::RefCell::new(vec![6, 7]);
+
+        let dropped = clear_stale_audio(&audio_rx, &pending);
+
+        assert_eq!(dropped, 7);
+        assert!(pending.borrow().is_empty());
+        assert!(matches!(
+            audio_rx.try_recv(),
+            Err(mpsc::TryRecvError::Empty)
+        ));
+    }
+}
