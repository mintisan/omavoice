                 _ = tokio::signal::ctrl_c() => {
                     let mic_close = session_protocol.mic_close_cmd(
                         protocol::types::StreamId::ANY,
@@ -483,6 +489,17 @@ async fn main() -> anyhow::Result<()> {
                 tracing::error!("PipeWire thread panicked: {panic:?}");
