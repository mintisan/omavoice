[Unit]
Description=OmaVoice Handy speech input service
Documentation=https://github.com/mintisan/omavoice
After=graphical-session.target pipewire.service wireplumber.service omavoice-atvvoice.service
Wants=pipewire.service wireplumber.service omavoice-atvvoice.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionFileIsExecutable=%h/.local/bin/omavoice-handy
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/omavoice-handy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=graphical-session.target
